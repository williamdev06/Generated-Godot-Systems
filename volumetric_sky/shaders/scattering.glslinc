// OWNS:       Single + multiple scattering integration along a ray (Hillaire 2020).
// DEPENDS:    atmosphere.glslinc included first; `transmittance_lut` declared, and `multi_scatter_lut`
//             declared unless MULTI_SCATTERING_PASS is defined.
// INVARIANTS: Luminance is in the units of `sun_illuminance` (INV-4).
// GOTCHAS:    MULTI_SCATTERING_PASS swaps phase functions for isotropic and adds ground bounce, which is
//             what the multi-scattering LUT derivation needs. No other pass should define it.
//             CLOUD_SHADOWED_SCATTERING requires the includer to define
//             float cloud_shadow_transmittance(vec3 planet_position); only single scattering is shadowed.
//             SCATTERING_SAMPLE_OFFSET (position of each sample inside its step, 0..1) may be defined by the
//             includer, e.g. as a per-frame jitter; defaults to 0.3.
//             MIE_SINGLE_SCATTERING_SCALE multiplies the cloud-shadowed sun single scattering by aerosols
//             (Mie) in luminance; Rayleigh (sky color) is untouched. Artistic: extinction is unchanged.
//             Defaults to 1.0.

#ifndef SCATTERING_SAMPLE_OFFSET
#define SCATTERING_SAMPLE_OFFSET 0.3
#endif
#ifndef MIE_SINGLE_SCATTERING_SCALE
#define MIE_SINGLE_SCATTERING_SCALE 1.0
#endif

struct ScatteringResult {
	vec3 luminance;
	vec3 transmittance;
	vec3 multi_scatter_as_1;
	vec3 cloud_shadow_loss; // single scattering removed by cloud shadow; already excluded from luminance
	vec3 lit_mie_scattering; // cloud-shadowed Mie single scattering before MIE_SINGLE_SCATTERING_SCALE
};

ScatteringResult empty_scattering_result() {
	ScatteringResult result;
	result.luminance = vec3(0.0);
	result.transmittance = vec3(1.0);
	result.multi_scatter_as_1 = vec3(0.0);
	result.cloud_shadow_loss = vec3(0.0);
	result.lit_mie_scattering = vec3(0.0);
	return result;
}

// Where a ray from `origin` is inside the atmosphere: x start km, y end km (ground hit or top exit).
// Empty when y <= x.
vec2 atmosphere_ray_extent(vec3 origin, vec3 direction) {
	vec2 top_hit = ray_sphere(origin, direction, TOP_RADIUS_KM);
	if (top_hit.y < 0.0) {
		return vec2(0.0);
	}
	vec2 ground_hit = ray_sphere(origin, direction, GROUND_RADIUS_KM);
	return vec2(max(top_hit.x, 0.0), ground_hit.x > 0.0 ? ground_hit.x : top_hit.y);
}

// Adds one sample of length step_km at planet-centric `position` to `result`. Phases are per ray.
void accumulate_scattering_sample(inout ScatteringResult result, vec3 position, float step_km, vec3 sun_direction, vec3 sun_illuminance, float mie_phase, float ray_phase) {
	float height = length(position);
	float sun_zenith_cos = dot(position / height, sun_direction);
	Medium medium = sample_medium(height - GROUND_RADIUS_KM);
	vec3 sample_transmittance = exp(-medium.extinction * step_km);
	vec3 sun_transmittance = textureLod(transmittance_lut, transmittance_uv(height, sun_zenith_cos), 0.0).rgb;
	float planet_shadow = ray_sphere(position, sun_direction, GROUND_RADIUS_KM).x > 0.0 ? 0.0 : 1.0;
#ifdef MULTI_SCATTERING_PASS
	vec3 phase_scattering = medium.scattering / (4.0 * PI);
	vec3 mie_phase_scattering = vec3(0.0);
	vec3 multi_scattering = vec3(0.0);
#else
	vec3 mie_phase_scattering = vec3(medium.mie_scattering * mie_phase);
	vec3 phase_scattering = medium.rayleigh_scattering * ray_phase + mie_phase_scattering;
	vec3 multi_scattering = textureLod(multi_scatter_lut, multi_scatter_uv(height, sun_zenith_cos), 0.0).rgb * medium.scattering;
#endif
#ifdef CLOUD_SHADOWED_SCATTERING
	float cloud_transmittance = cloud_shadow_transmittance(position);
#else
	float cloud_transmittance = 1.0;
#endif
	vec3 sun_at_sample = sun_illuminance * planet_shadow * sun_transmittance;
	vec3 single_scattering = sun_at_sample * phase_scattering;
	vec3 lit_mie_scattering = sun_at_sample * mie_phase_scattering * cloud_transmittance;
	vec3 in_scattering = single_scattering * cloud_transmittance + lit_mie_scattering * (MIE_SINGLE_SCATTERING_SCALE - 1.0) + sun_illuminance * multi_scattering;
	vec3 shadowed_scattering = single_scattering * (1.0 - cloud_transmittance);
	// Energy-conserving analytic integration over the step (Hillaire 2015).
	vec3 extinction = max(medium.extinction, vec3(1e-7));
	result.multi_scatter_as_1 += result.transmittance * (medium.scattering - medium.scattering * sample_transmittance) / extinction;
	result.luminance += result.transmittance * (in_scattering - in_scattering * sample_transmittance) / extinction;
	result.cloud_shadow_loss += result.transmittance * (shadowed_scattering - shadowed_scattering * sample_transmittance) / extinction;
	result.lit_mie_scattering += result.transmittance * (lit_mie_scattering - lit_mie_scattering * sample_transmittance) / extinction;
	result.transmittance *= sample_transmittance;
}

ScatteringResult integrate_scattering(vec3 origin, vec3 direction, vec3 sun_direction, vec3 sun_illuminance, int sample_count, float max_distance_km) {
	ScatteringResult result = empty_scattering_result();
	vec2 extent = atmosphere_ray_extent(origin, direction);
	float start_km = extent.x;
	float end_km = min(extent.y, max_distance_km);
	if (end_km <= start_km) {
		return result;
	}
	float step_km = (end_km - start_km) / float(sample_count);
	float cos_theta = dot(direction, sun_direction);
	float mie_phase = henyey_greenstein(cos_theta, MIE_ANISOTROPY);
	float ray_phase = rayleigh_phase(cos_theta);
	for (int i = 0; i < sample_count; i++) {
		vec3 position = origin + direction * (start_km + (float(i) + SCATTERING_SAMPLE_OFFSET) * step_km);
		accumulate_scattering_sample(result, position, step_km, sun_direction, sun_illuminance, mie_phase, ray_phase);
	}

#ifdef MULTI_SCATTERING_PASS
	vec2 ground_hit = ray_sphere(origin, direction, GROUND_RADIUS_KM);
	if (ground_hit.x > 0.0 && end_km == ground_hit.x) {
		vec3 ground_position = origin + direction * end_km;
		float ground_height = length(ground_position);
		float sun_zenith_cos = dot(ground_position / ground_height, sun_direction);
		vec3 sun_transmittance = textureLod(transmittance_lut, transmittance_uv(ground_height, sun_zenith_cos), 0.0).rgb;
		result.luminance += sun_illuminance * sun_transmittance * result.transmittance * clamp(sun_zenith_cos, 0.0, 1.0) * GROUND_ALBEDO / PI;
	}
#endif
	return result;
}
